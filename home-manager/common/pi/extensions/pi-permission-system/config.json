{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "piInfrastructureReadPaths": [
    "~/.pi/agent/skills",
    "~/.agents/skills",
    "/tmp/pi-clipboard-*",
    "/private/tmp/pi-clipboard-*",
    "/var/folders/*/T/pi-clipboard-*",
    "/private/var/folders/*/T/pi-clipboard-*"
  ],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "/": "deny",
      "~": "deny",
      "~/.config": "deny",
      "~/.local": "deny",
      "~/.local/share": "deny",
      "~/Library": "deny",
      "~/.pi": "deny",
      "~/.pi/*": "deny",
      "~/.pi/agent/npm": "allow",
      "~/.pi/agent/npm/*": "allow",
      "~/.pi/agent/git": "allow",
      "~/.pi/agent/git/*": "allow",
      "~/.pi/agent/skills": "allow",
      "~/.pi/agent/skills/*": "allow",
      "~/.pi/agent/agents": "allow",
      "~/.pi/agent/agents/*": "allow",
      "~/.pi/agent/themes": "allow",
      "~/.pi/agent/themes/*": "allow",
      "~/.pi/agent/APPEND_SYSTEM.md": "allow",
      "~/.pi/agent/AGENTS.md": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*/auth.json*": "deny",
      "*/.npmrc*": "deny",
      "*/.netrc*": "deny",
      "~/.gnupg*": "deny",
      "~/.aws*": "deny",
      "~/.kube*": "deny",
      "~/.git-credentials*": "deny",
      "~/.docker/config.json*": "deny",
      "~/.config/gcloud*": "deny",
      "~/.config/sops*": "deny",
      "~/.config/gh*": "deny",
      "~/.config/mcp*": "deny",
      "~/.local/share/opencode*": "deny",
      "~/.codex*": "deny",
      "~/.claude*": "deny",
      "~/.gemini*": "deny",
      "~/.pig*": "deny",
      "~/Library/Keychains*": "deny",
      "~/Documents/Work/Straitpoint/Creds*": "deny",
      "~/.config/fish/secrets.fish*": "deny",
      "~/.config/nushell/secrets.nu*": "deny",
      "~/.config/shell-secrets.env*": "deny",
      "~/.config/winapps/winapps.conf*": "deny",
      "/run/secrets*": "deny",
      "*/secrets.d": "deny",
      "*/secrets.d/*": "deny"
    },
    "read": { "*": "allow", "~/.ssh*": "deny" },
    "grep": { "*": "allow", "~/.ssh*": "deny" },
    "find": { "*": "allow", "~/.ssh*": "deny" },
    "ls": { "*": "allow", "~/.ssh*": "deny" },
    "write": {
      "*": "allow",
      "~/.pi/*": "deny",
      "~/.pi/agent/skills/*": "allow",
      "~/.ssh*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.pi/*": "deny",
      "~/.pi/agent/skills/*": "allow",
      "~/.ssh*": "deny"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "context7": "allow",
      "context7:*": "allow",
      "exa": "allow",
      "exa:*": "allow"
    },
    "bash": {
      "*": "ask",
      "*.ssh*": "deny",
      "ssh *": "ask",
      "/usr/bin/ssh *": "ask",
      "pi-tmp-rm *": "allow",
      "rm *": {
        "action": "deny",
        "reason": "Use pi-tmp-rm /tmp/<path>; deletion outside /tmp is not allowed."
      },
      "*/rm *": "deny",
      "rmdir *": "deny",
      "*/rmdir *": "deny",
      "unlink *": "deny",
      "*/unlink *": "deny",
      "* -delete*": "deny",
      "find * -exec*": "deny",
      "find * -ok*": "deny",
      "xargs *rm*": "deny",
      "command rm *": "deny",
      "shred *": "deny",
      "wipefs *": "deny",
      "mkfs*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "diskutil erase*": "deny",
      "dd *": "deny",
      "chmod -R *": "deny",
      "chown -R *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "sudo *": "deny",
      "doas *": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/nix/store/*": "allow",
      "~/.pi/agent/npm": "allow",
      "~/.pi/agent/npm/*": "allow",
      "~/.pi/agent/git": "allow",
      "~/.pi/agent/git/*": "allow",
      "~/.pi/agent/skills": "allow",
      "~/.pi/agent/skills/*": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow",
      "~/.ssh": "allow",
      "~/.ssh/*": "allow"
    }
  }
}
