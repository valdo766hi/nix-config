{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [14, 22],
  "preview": "layouts/dusk.svg",
  "background": "canvas",
  "colors": {
    "background": "#1e1e2e",
    "canvas": "#1e1e2e",
    "chrome": "#181825",
    "selected": "#313244",
    "hover": "#262637",
    "border": "#313244",
    "accent": "#cba6f7",
    "accent_foreground": "#1e1e2e",
    "solid": "#cba6f7",
    "solid_foreground": "#1e1e2e",
    "foreground": "#cdd6f4",
    "muted": "#bac2de",
    "dim": "#7f849c"
  },
  "terminal_padding": [18, 24],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 260 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 58 },
          "window_drag": true,
          "content": { "mod": "dusk-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "dusk-spaces" }
            },
            {
              "id": "agents",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "agents" }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 52 },
          "content": { "mod": "dusk-chrome", "props": { "footer": true } }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "dusk-tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 0,
                  "radius": 0,
                  "background": "background",
                  "lone": false,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "border": { "width": 1, "color": "border" },
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "hidden": true,
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
